@page "/chat"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.Extensions.Logging
@using PetWorld.Application.Models.Request
@using PetWorld.Application.Models.Response
@inject PetWorld.Application.UseCases.Chat.AskChatUseCase AskChatUseCase
@inject ILogger<Chat> Logger
@implements IDisposable

<PageTitle>Chat z klientem</PageTitle>

<div class="d-flex flex-column gap-3">
    <div>
        <h1 class="mb-1">Chat z klientem</h1>
        <p class="text-muted mb-0">Zadaj pytanie klienta, a system Writer-Critic przygotuje odpowiedź i poda liczbę iteracji.</p>
    </div>

    <EditForm Model="_chatModel" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label" for="questionInput">Pytanie klienta</label>
            <InputTextArea id="questionInput"
                           class="form-control"
                           rows="4"
                           @bind-Value="_chatModel.Question"
                           placeholder="Np. Szukam karmy dla dorosłego psa średniej rasy w budżecie do 300 zł." />
        </div>

        <button class="btn btn-primary" type="submit" disabled="@_isSubmitting">
            @if (_isSubmitting)
            {
                <span>Wysyłanie...</span>
            }
            else
            {
                <span>Wyślij</span>
            }
        </button>
    </EditForm>

    @if (_errors.Count > 0)
    {
        <div class="alert alert-danger mb-0" role="alert">
            <strong>Nie udało się przetworzyć zapytania:</strong>
            <ul class="mb-0 mt-2">
                @foreach (var error in _errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (_lastResponse is not null)
    {
        <section class="card border-success">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                    <h2 class="h5 mb-0">Odpowiedź dla klienta</h2>
                    <span class="badge text-bg-success">Liczba iteracji: @_lastResponse.Iterations</span>
                </div>
                <p class="mb-0 chat-text">@_lastResponse.Answer</p>
            </div>
        </section>
    }
</div>

@code {
    private readonly ChatFormModel _chatModel = new();
    private ChatResponse? _lastResponse;
    private bool _isSubmitting;
    private CancellationTokenSource? _pageCts;
    private readonly List<string> _errors = new();
    private const string GenericUserErrorMessage = "Wystąpił problem podczas przetwarzania zapytania. Spróbuj ponownie za chwilę.";

    protected override void OnInitialized()
    {
        _pageCts = new CancellationTokenSource();
    }

    private async Task HandleSubmit()
    {
        var question = _chatModel.Question.Trim();
        if (string.IsNullOrWhiteSpace(question))
        {
            _errors.Clear();
            _errors.Add("Pytanie nie może składać się wyłącznie z białych znaków.");
            return;
        }

        _errors.Clear();
        _isSubmitting = true;

        try
        {
            var result = await AskChatUseCase.ExecuteAsync(new AskChatRequest(question), _pageCts?.Token ?? CancellationToken.None);

            if (result.IsFailed)
            {
                _errors.Add(GetUserMessage(result.Errors));
                return;
            }

            _lastResponse = result.Value;
            _chatModel.Question = string.Empty;
        }
        catch (OperationCanceledException)
        {
            Logger.LogDebug("Chat request was canceled.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while processing chat question.");
            _errors.Add(GenericUserErrorMessage);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public void Dispose()
    {
        _pageCts?.Cancel();
        _pageCts?.Dispose();
        _pageCts = null;
    }

    private static string GetUserMessage(IEnumerable<string> errors)
    {
        var errorList = errors
            .Where(error => !string.IsNullOrWhiteSpace(error))
            .Select(error => error.Trim())
            .ToList();

        if (errorList.Count == 0)
        {
            return GenericUserErrorMessage;
        }

        var openAiConfigError = errorList.FirstOrDefault(error =>
            error.Contains("OPENAI_API_KEY", StringComparison.OrdinalIgnoreCase));

        return openAiConfigError ?? errorList[0];
    }

    private sealed class ChatFormModel
    {
        [Required(ErrorMessage = "Pytanie nie może być puste.")]
        [StringLength(Domain.ValueObjects.Question.MaxLength, ErrorMessage = "Pytanie może mieć maksymalnie {1} znaków.")]
        public string Question { get; set; } = string.Empty;
    }
}
