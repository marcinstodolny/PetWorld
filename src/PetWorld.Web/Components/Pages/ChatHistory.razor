@page "/chat-history"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using PetWorld.Application.Models.Response
@inject PetWorld.Application.UseCases.Chat.GetChatHistoryUseCase GetChatHistoryUseCase

<PageTitle>Historia czatu</PageTitle>

<h1>Historia czatu (Use Case)</h1>

<p>Lista zapisanych wiadomości z bazy danych.</p>

@if (_isLoading)
{
    <p><em>Ładowanie historii...</em></p>
}
else if (_history.Count == 0)
{
    <p><em>Brak zapisanych wiadomości.</em></p>
}
else
{
    <QuickGrid Items="@_history.AsQueryable()" Class="table">
        <PropertyColumn Property="@(item => item.CreatedAt)" Title="Data" Format="g" />
        <PropertyColumn Property="@(item => item.Question)" Title="Pytanie" />
        <PropertyColumn Property="@(item => item.Answer)" Title="Odpowiedź" />
        <PropertyColumn Property="@(item => item.Iterations)" Title="Iteracje" />
    </QuickGrid>
}

<button class="btn btn-secondary" @onclick="LoadHistory" disabled="@_isLoading">Odśwież</button>

@code {
    private bool _isLoading = true;
    private IReadOnlyList<ChatHistoryItemResponse> _history = Array.Empty<ChatHistoryItemResponse>();

    protected override async Task OnInitializedAsync()
    {
        await LoadHistory();
    }

    private async Task LoadHistory()
    {
        _isLoading = true;
        _history = await GetChatHistoryUseCase.ExecuteAsync();
        _isLoading = false;
    }
}
