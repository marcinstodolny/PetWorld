@page "/chat-history"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.Extensions.Logging
@using PetWorld.Application.Models.Response
@inject PetWorld.Application.UseCases.Chat.GetChatHistoryUseCase GetChatHistoryUseCase
@inject ILogger<ChatHistory> Logger
@implements IDisposable

<PageTitle>Historia czatu</PageTitle>

<div class="d-flex flex-column gap-3">
    <div>
        <h1 class="mb-1">Historia czatu</h1>
        <p class="text-muted mb-0">Lista zapisanych pytań i odpowiedzi wygenerowanych przez system Writer-Critic.</p>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="text-muted">Liczba wiadomości: @_history.Count</span>
        <button class="btn btn-outline-secondary" @onclick="LoadHistory" disabled="@_isLoading">Odśwież</button>
    </div>

    @if (_isLoading)
    {
        <p><em>Ładowanie historii...</em></p>
    }
    else if (_errors.Count > 0)
    {
        <div class="alert alert-danger mb-0" role="alert">
            <strong>Nie udało się pobrać historii:</strong>
            <ul class="mb-0 mt-2">
                @foreach (var error in _errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }
    else if (_history.Count == 0)
    {
        <div class="alert alert-info mb-0" role="alert">
            Brak zapisanych wiadomości.
        </div>
    }
    else
    {
        <QuickGrid Items="@_history.AsQueryable()" Class="table table-striped table-hover align-middle" Pagination="_pagination">
            <PropertyColumn Property="@(item => item.CreatedAt)" Title="Data" Format="yyyy-MM-dd HH:mm" Sortable="true" />
            <TemplateColumn Title="Pytanie"><div class="chat-text">@context.Question</div></TemplateColumn>
            <TemplateColumn Title="Odpowiedź"><div class="chat-text">@context.Answer</div></TemplateColumn>
            <PropertyColumn Property="@(item => item.Iterations)" Title="Liczba iteracji" Sortable="true" />
        </QuickGrid>

        <Paginator State="_pagination" />
    }
</div>

@code {
    private bool _isLoading = true;
    private IReadOnlyList<ChatHistoryItemResponse> _history = Array.Empty<ChatHistoryItemResponse>();
    private readonly PaginationState _pagination = new() { ItemsPerPage = 10 };
    private CancellationTokenSource? _loadCts;
    private readonly List<string> _errors = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadHistory();
    }

    private async Task LoadHistory()
    {
        _isLoading = true;

        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();

        try
        {
            var result = await GetChatHistoryUseCase.ExecuteAsync(_loadCts.Token);

            if (result.IsFailed)
            {
                _errors.Clear();
                _errors.AddRange(result.Errors);
                return;
            }

            _history = result.Value;
            _errors.Clear();
        }
        catch (OperationCanceledException) when (_loadCts.Token.IsCancellationRequested)
        {
            Logger.LogDebug("History refresh was canceled.");
        }
        finally
        {
            _isLoading = false;
        }
    }

    public void Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
    }
}
