@page "/chat-history"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using PetWorld.Application.Models.Response
@inject PetWorld.Application.UseCases.Chat.GetChatHistoryUseCase GetChatHistoryUseCase

<PageTitle>Historia czatu</PageTitle>

<div class="d-flex flex-column gap-3">
    <div>
        <h1 class="mb-1">Historia czatu</h1>
        <p class="text-muted mb-0">Lista zapisanych pytań i odpowiedzi wygenerowanych przez system Writer-Critic.</p>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="text-muted">Liczba wiadomości: @_history.Count</span>
        <button class="btn btn-outline-secondary" @onclick="LoadHistory" disabled="@_isLoading">Odśwież</button>
    </div>

    @if (_isLoading)
    {
        <p><em>Ładowanie historii...</em></p>
    }
    else if (_history.Count == 0)
    {
        <div class="alert alert-info mb-0" role="alert">
            Brak zapisanych wiadomości.
        </div>
    }
    else
    {
        <QuickGrid Items="@_history.AsQueryable()"
                   Class="table table-striped table-hover align-middle"
                   Pagination="_pagination">
            <PropertyColumn Property="@(item => item.CreatedAt)" Title="Data" Format="yyyy-MM-dd HH:mm" Sortable="true" />
            <PropertyColumn Property="@(item => item.Question)" Title="Pytanie" />
            <PropertyColumn Property="@(item => item.Answer)" Title="Odpowiedź" />
            <PropertyColumn Property="@(item => item.Iterations)" Title="Liczba iteracji" Sortable="true" />
        </QuickGrid>

        <Paginator State="_pagination" />
    }
</div>

@code {
    private bool _isLoading = true;
    private IReadOnlyList<ChatHistoryItemResponse> _history = Array.Empty<ChatHistoryItemResponse>();
    private readonly PaginationState _pagination = new() { ItemsPerPage = 10 };

    protected override async Task OnInitializedAsync()
    {
        await LoadHistory();
    }

    private async Task LoadHistory()
    {
        _isLoading = true;
        _history = await GetChatHistoryUseCase.ExecuteAsync();
        _isLoading = false;
    }
}
